}
plotPCA_Eigent(res.pca)
plotPCA_Eigent <- function(res.pca) {
stopifnot(!is.null(res.pca))
df <- data.frame(
PC = rownames(res.pca$eig),
var = res.pca$eig[, 2],
cumvar = res.pca$eig[, 3],
eig = res.pca$eig[, 1]
)
plotly::plot_ly(df, x = ~PC) |>
plotly::add_bars(
y = ~var,
name = "% of variances",
marker = list(color = "rgba(100,150,200,0.8)")
) |>
plotly::add_lines(
y = ~cumvar,
name = "Cumulative % of variances",
line = list(color = "darkblue", width = 2),
marker = list(color = "darkblue", size = 6)
) |>
plotly::layout(
xaxis = list(title = "Principal Components"),
yaxis = list(
title = "% of variances",
range = c(0, 100),
ticksuffix = "%"
),
plot_bgcolor = "#f5f5f5",
paper_bgcolor = "#f5f5f5",
legend = list(
orientation = "h",
x = 0,
y = -0.3
)
)
}
