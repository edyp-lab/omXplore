supp_lignes_na <- function(X) {
is.empty <- function(l) {
sum(is.na(l)) == length(l)
}
ll <- c()
for (i in seq_len(nrow(X))) {
if (is.empty(X[i, ])) {
ll <- c(ll, i)
}
}
if (length(ll > 0)) {
X <- X[-ll, ]
}
return(X)
}
